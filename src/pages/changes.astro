---
import CatalogLayout from '../layouts/CatalogLayout.astro';
import { activeProfile, activeSources, activeCoverage, sourceState, siteBuiltAt, recentChanges, formatDate, safeUrl, displayText, errorText, countText } from '../lib/catalog.js';
const base = import.meta.env.BASE_URL;
const changes = [...recentChanges].sort((a,b) => Date.parse(b.at)-Date.parse(a.at)).slice(0, 30);
---
<CatalogLayout title="Изменения и свежесть" current="changes">
  <div class="page-intro"><div><p class="eyebrow">Наблюдение и обновления</p><h1>Изменения</h1><p>Последняя попытка и последний успешный сбор различаются. Ошибка не стирает прежний факт и его дату.</p></div></div>
  <section class="catalog-section" aria-labelledby="sources-title">
    <div class="section-heading"><div><p class="eyebrow">Профиль: {activeProfile?.id || 'не выбран'}</p><h2 id="sources-title">Состояние источников</h2></div><a class="quiet-link" href={`${base}method/`}>Пороги свежести</a></div>
    {activeSources.length ? <div class="source-list">{activeSources.map((source) => { const state = sourceState[source.id]; const cover = activeCoverage.filter((c) => c.sourceId === source.id); return <article class="source-card"><div class="source-card-head"><h3>{source.id}</h3><span data-freshness={state?.lastSuccessAt || ''} data-frequency={state?.expectedFrequency || source.frequency}>Проверка свежести…</span></div><p>{displayText(source.scope)}</p><dl class="fact-grid"><div><dt>Последняя попытка</dt><dd>{formatDate(state?.lastAttemptAt)}</dd></div><div><dt>Последний успех</dt><dd>{formatDate(state?.lastSuccessAt)}</dd></div><div><dt>Частота</dt><dd>{source.frequency === 'weekly' ? 'Еженедельно' : 'Ежедневно'}</dd></div><div><dt>Ошибка</dt><dd>{errorText(state?.error)}{state?.error && <details><summary>Технические подробности (язык источника)</summary><code>{String(state.error)}</code></details>}</dd></div></dl><p class="small-note">{cover.length ? `${countText(cover.length, 'запись', 'записи', 'записей')} покрытия; ${cover.some((c) => !c.backfillComplete) ? 'история неполная' : 'заявленное окно собрано'}.` : 'Покрытие не установлено.'} <a href={`${base}method/#coverage`}>Границы покрытия</a></p>{safeUrl(source.url) && <a class="text-link" href={safeUrl(source.url)} target="_blank" rel="noopener noreferrer">Открыть источник ↗</a>}</article>; })}</div> : <div class="empty-state"><h3>Источники для профиля не настроены</h3><p>Результаты прежних профилей здесь не используются.</p></div>}
  </section>
  <section class="catalog-section" aria-labelledby="history-title"><div class="section-heading"><div><p class="eyebrow">Последние записи снимка</p><h2 id="history-title">История обновлений</h2></div></div>
    {changes.length ? <ol class="change-list">{changes.map((item) => <li><time datetime={item.at}>{formatDate(item.at)}</time><span>{item.change === 'ADDED' ? 'Добавлена запись' : item.change === 'UPDATED' ? 'Обновлена запись' : item.change}</span><code>{item.sourceId}</code><small>Событие {item.id}</small></li>)}</ol> : <p class="empty-copy">Для этого профиля изменений пока нет.</p>}
  </section>
  <p class="build-note">Сборка сайта: {formatDate(siteBuiltAt)}. Она не подтверждает новую проверку источников.</p>
</CatalogLayout>
