---
import CatalogLayout from '../../layouts/CatalogLayout.astro';
import { activePairs, activeProfile, pairNodes, pairTitle, displayValue, formatDate, statusText, provenanceText, decisionText, criterionName, nodeSources, coverageFor, eventsFor, recentEventsFor, evidenceFor, sourceState, safeUrl, eventCountText, eventMetrics, formatDuration } from '../../lib/catalog.js';
export function getStaticPaths() { return activePairs.map((pair) => ({ params: { id: pair.id }, props: { pair } })); }
const { pair } = Astro.props;
const [entry, foreign] = pairNodes(pair);
const nodes = [entry, foreign];
const base = import.meta.env.BASE_URL;
const propertyNames = {brand:'Бренд',owner:'Юридическое лицо',city:'Город',datacenter:'Площадка',asn:'ASN будущего VPS',prefixes:'Префикс будущего VPS',plan:'Тариф',resources:'Ресурсы',ipv4:'IPv4',linux:'Linux',virtualization:'Виртуализация',recovery:'Восстановление',reinstall:'Переустановка',billing:'Оплата',tax:'Налог',availability:'Наличие при заказе'};
const valueFor = (property) => {
  if (!property || property.value == null) return 'Не установлено';
  if (typeof property.value !== 'object') return displayValue(property.value);
  if (property.value.vcpu) return `${property.value.vcpu} vCPU · ${property.value.ramGB ?? property.value.ramGiB ?? '?'} ГБ RAM · ${property.value.diskGB ?? property.value.diskGiB ?? '?'} ГБ диск`;
  return displayValue(property.value);
};
---
<CatalogLayout title={pairTitle(pair)} current="pairs">
  <p class="breadcrumbs"><a href={base}>Пары</a><span aria-hidden="true">/</span>{pairTitle(pair)}</p>
  <div class="page-intro pair-intro"><div><p class="eyebrow">{activeProfile?.originLocation.city} → {activeProfile?.foreignExit.city}</p><h1>{pairTitle(pair)}</h1><p>Два VPS для одного сохранённого профиля. Опубликованные условия и история провайдера не подтверждают работу конкретной цепочки.</p></div><span class="decision" data-decision={pair.decision}>{decisionText(pair.decision)}</span></div>
  <section class="decision-panel" aria-labelledby="decision-title"><p class="eyebrow">Редакционное решение</p><h2 id="decision-title">{decisionText(pair.decision)}</h2><p>{pair.reason}</p><p class="small-note">Домашний маршрут: не проверен. Дата решения: {formatDate(pair.decisionAt)}.</p></section>
  <section class="catalog-section" aria-labelledby="legs-title"><div class="section-heading"><div><p class="eyebrow">Две отдельные услуги</p><h2 id="legs-title">Узлы и условия</h2></div></div><div class="node-grid">{nodes.map((node, index) => <article class="node-card"><p class="eyebrow">{index === 0 ? '01 · Первый VPS' : '02 · Зарубежный выход'}</p><h3>{displayValue(node?.properties.brand?.value)}</h3><p>{displayValue(node?.properties.city?.value)} · {displayValue(node?.properties.plan?.value)}</p><dl class="properties">{Object.entries(propertyNames).map(([key, label]) => { const prop = node?.properties[key]; if (!prop) return null; return <div><dt>{label}</dt><dd><span>{valueFor(prop)}</span><small>{provenanceText(prop.provenance)} · {formatDate(prop.observedAt)} · {prop.provenance !== 'UNKNOWN' && prop.value != null && <span data-freshness={prop.observedAt} data-frequency="weekly">Проверка свежести…</span>}</small><small>{prop.scope}</small>{safeUrl(prop.sourceUrl) && <a href={safeUrl(prop.sourceUrl)} target="_blank" rel="noopener noreferrer">Источник ↗</a>}</dd></div>; })}</dl></article>)}</div></section>
  <section class="catalog-section" aria-labelledby="price-title"><div class="section-heading"><div><p class="eyebrow">Без пересчёта валют</p><h2 id="price-title">Тарифы в месяц</h2></div></div><div class="price-grid">{pair.price.components.map((part) => <article class="price-card"><strong>{part.amount ?? '?'} {part.currency ?? ''}</strong><span>{part.label}</span><p>{part.included}. {part.conditions}</p><small>Проверено: {formatDate(part.observedAt)} · <span data-freshness={part.observedAt} data-frequency="weekly">Проверка свежести…</span> · {part.scope}</small>{safeUrl(part.sourceUrl) && <a href={safeUrl(part.sourceUrl)} target="_blank" rel="noopener noreferrer">Тариф и условия ↗</a>}</article>)}</div><p class="small-note">{pair.price.scope}</p></section>
  <section class="catalog-section" aria-labelledby="criteria-title"><div class="section-heading"><div><p class="eyebrow">Условия, не доступность</p><h2 id="criteria-title">Критерии пары</h2></div></div><div class="criteria-list">{pair.criteria.map((criterion) => <div class="criterion"><div><strong>{criterionName(criterion.id)}</strong><span class="criterion-status" data-status={criterion.status}>{statusText(criterion.status)}</span></div><p>{criterion.reason}</p><small>{criterion.mandatory ? 'Обязательное условие' : 'Дополнительное условие'} · {provenanceText(criterion.provenance)} · {formatDate(criterion.evaluatedAt)} · {criterion.status === 'PASS' && <span data-freshness={criterion.evaluatedAt} data-frequency="weekly">Проверка свежести…</span>}</small>{safeUrl(criterion.sourceUrl) && <a href={safeUrl(criterion.sourceUrl)} target="_blank" rel="noopener noreferrer">Источник ↗</a>}</div>)}</div></section>
  <section class="catalog-section" aria-labelledby="depends-title"><div class="section-heading"><div><p class="eyebrow">Общая причина возможного отказа</p><h2 id="depends-title">Зависимости</h2></div></div><p>{pair.geoconcentration}</p><ul class="plain-list">{pair.dependencies.map((dep) => <li><strong>{dep.value}</strong> — {dep.scope} {safeUrl(dep.sourceUrl) && <a href={safeUrl(dep.sourceUrl)} target="_blank" rel="noopener noreferrer">Источник ↗</a>}</li>)}</ul></section>
  <section class="catalog-section" aria-labelledby="history-title"><div class="section-heading"><div><p class="eyebrow">Общая статистика поставщика</p><h2 id="history-title">История и её границы</h2></div></div><p class="scope-warning">События статус-панели описывают компанию, услугу или площадку в указанной источником области. Они не доказывают отказ или доступность этого VPS. Плановые работы исключены из счётчиков аварий. Прикладной путь этой пары и домашний маршрут не измерены. Даже событие класса C в общей панели не доказывает состояние конкретной цепочки. Длительности ниже относятся к завершённым записям статус-панели, а не к простою VPS или пары.</p><div class="source-list">{nodes.map((node) => <article class="source-card"><h3>{displayValue(node?.properties.brand?.value)}</h3>{nodeSources(node).length ? nodeSources(node).map((source) => { const state = sourceState[source.id]; const coverage = coverageFor(source.id); const events = recentEventsFor(source.id, 5); return <div class="source-part"><p>{source.scope}</p><p><span data-freshness={state?.lastSuccessAt || ''} data-frequency={state?.expectedFrequency || source.frequency}>Проверка свежести…</span> · последний успех {formatDate(state?.lastSuccessAt)}</p>{state?.error && <p class="source-error">Ошибка последней попытки: {String(state.error)}</p>}<div class="class-counts">{['A','B','C'].map((klass) => {const cover = coverage.find((c) => c.class === klass); const metrics = eventMetrics(source.id, klass); const count = metrics?.knownEventCount ?? 0; return <div><strong>Класс {klass}</strong><span>{cover?.observedStart ? eventCountText(count) : 'Нет покрытия'}</span><small>{cover?.observedStart ? `Окно расчёта: ${formatDate(cover.requestedStart)} — ${formatDate(state?.lastSuccessAt || cover.observedEnd)}` : 'Неизвестно'}</small>{cover?.observedStart && <small>Полученные записи: {formatDate(cover.observedStart)} — {formatDate(cover.observedEnd)}{!cover.backfillComplete ? ' · история неполная' : ''}</small>}{cover?.observedStart && <><small>MTTR завершённых: {metrics.resolvedSampleSize ? formatDuration(metrics.meanTimeToResolveMs) : 'Нет достаточной выборки'} · n={metrics.resolvedSampleSize}</small><small>Совокупная длительность интервалов: {metrics.resolvedSampleSize ? formatDuration(metrics.knownIntervalUnionMs) : 'Не рассчитывается'}</small></>}</div>})}</div>{coverage.some((c) => !c.backfillComplete || c.gaps?.length) && <p class="small-note">История неполная или имеет оговорки. <a href={`${base}method/#coverage`}>Как читать покрытие</a></p>}{events.length ? <details><summary>Последние события источника</summary><ul class="event-list">{events.map((event) => <li><strong>{event.title}</strong><small>{formatDate(event.startedAt)} · класс {event.class} · {event.status === 'RESOLVED' ? 'завершено' : 'открыто'}</small><small>{event.affected.map((x) => `${x.type}: ${x.value}`).join(' · ')}</small>{evidenceFor(event).filter((e) => safeUrl(e.url)).map((e) => <a href={safeUrl(e.url)} target="_blank" rel="noopener noreferrer">Публикация источника ↗</a>)}</li>)}</ul></details> : <p class="small-note">Событий в доступном снимке нет; это не доказательство отсутствия аварий.</p>}</div>; }) : <p>Официальная статус-страница может существовать, но импорт истории для этого узла не связан с реестром. A/B/C: неизвестно. {safeUrl(node?.properties.statusPage?.value) && <a href={safeUrl(node.properties.statusPage.value)} target="_blank" rel="noopener noreferrer">Статус-страница ↗</a>}</p>}</article>)}</div></section>
  <p class="build-note">Перед покупкой проверьте заказ, IP/ASN, условия счёта и прикладную доступность в собственном маршруте.</p>
</CatalogLayout>
