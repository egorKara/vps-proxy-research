---
import BaseLayout from "../layouts/BaseLayout.astro";
import vpsEU from "../data/vps_eu.json";
import proxyUS from "../data/proxy_us.json";

const baseUrl = import.meta.env.BASE_URL;
const countries = Array.from(new Set(vpsEU.map((x) => x.country))).sort();
const tiers = ["A", "B", "C", "D"];

const statusLabel = (value) => {
	if (value === "available") return "есть";
	if (value === "sold_out") return "нет слотов";
	if (value === "unavailable") return "недоступно";
	return "не подтверждено";
};

const statusClass = (value) => {
	if (value === "available") return "badge badge--ok";
	if (value === "sold_out" || value === "unavailable") return "badge badge--warn";
	return "badge";
};
---

<BaseLayout title="Таблицы — VPS (EU) и Proxy (US)">
	<section class="card">
		<div class="card__inner">
			<h1 style="margin:0 0 6px;">Таблицы</h1>
			<p style="margin:0;" class="muted">
				VPS (EU) перепроверены 03.09.2026: 20 старых кандидатов + новые варианты. Tier и verification показывают качество текущей проверки.
			</p>
		</div>
	</section>

	<section class="card" style="margin-top:16px;">
		<div class="card__inner">
			<div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
				<div style="display:flex; gap:10px; flex-wrap:wrap;">
					<button class="nav__link is-active" id="tab-vps" type="button">VPS (EU)</button>
					<button class="nav__link" id="tab-proxy" type="button">Proxy (US)</button>
				</div>
				<div class="mini">Клик по провайдеру открывает первичный URL строки.</div>
			</div>

			<div id="panel-vps" style="margin-top:14px;">
				<div class="toolbar">
					<div class="controls">
						<div class="field">
							<label for="q">Поиск</label>
							<input class="input" id="q" placeholder="провайдер, город, тариф…" />
						</div>
						<div class="field">
							<label for="country">Страна</label>
							<select class="select" id="country">
								<option value="ALL">Все</option>
								{countries.map((c) => <option value={c}>{c}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="tier">Tier</label>
							<select class="select" id="tier">
								<option value="ALL">Все</option>
								{tiers.map((t) => <option value={t}>{t}</option>)}
							</select>
						</div>
						<div class="field">
							<label for="avail">Наличие</label>
							<select class="select" id="avail">
								<option value="ALL">Любое</option>
								<option value="available">Есть</option>
								<option value="unknown">Не подтверждено</option>
								<option value="bad">Нет слотов / недоступно</option>
							</select>
						</div>
					</div>
					<div class="kpi">
						<span class="pill"><span class="dot"></span><strong id="count">0</strong><span class="muted">позиций</span></span>
					</div>
				</div>

				<div class="table-scroll">
					<table class="dataTable">
						<thead>
							<tr>
								<th>#</th>
								<th>Tier</th>
								<th>Локация</th>
								<th>Провайдер</th>
								<th>План</th>
								<th>IPv4</th>
								<th>Цена</th>
								<th>Наличие</th>
								<th>Проверка</th>
								<th>Дата</th>
								<th>Заметка / изменение</th>
							</tr>
						</thead>
						<tbody id="rows">
							{vpsEU.map((x) => (
								<tr
									data-country={x.country}
									data-tier={x.tier}
									data-availability={x.availability}
									data-text={`${x.country} ${x.city} ${x.provider} ${x.plan} ${x.resources ?? ""} ${x.ipv4} ${x.price} ${x.notes} ${x.change ?? ""}`.toLowerCase()}
								>
									<td class="cell-muted">{x.id}</td>
									<td><span class="badge">{x.tier}</span></td>
									<td><span class="badge">{x.country}</span><span class="mini" style="margin-left:8px;">{x.city}</span></td>
									<td><a href={x.url} target="_blank" rel="noreferrer">{x.provider}</a></td>
									<td>{x.plan}</td>
									<td>{x.ipv4}</td>
									<td class="nowrap">{x.price}</td>
									<td><span class={statusClass(x.availability)}>{statusLabel(x.availability)}</span></td>
									<td><span class={x.verification === "confirmed" ? "badge badge--ok" : x.verification === "confirmed_unavailable" ? "badge badge--warn" : "badge"}>{x.verification}</span></td>
									<td class="nowrap">{x.verified_at}</td>
									<td class="cell-note">
										{x.notes}
										{x.change && <div class="mini" style="margin-top:6px;">Δ {x.change}</div>}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<p class="mini" style="margin:12px 0 0;">
					Полный вывод аудита: <a href={`${baseUrl}vps-eu/`}>VPS (EU)</a>. Источники каждой строки лежат в JSON.
				</p>
			</div>

			<div id="panel-proxy" style="margin-top:14px; display:none;">
				<div class="table-scroll">
					<table class="dataTable">
						<thead>
							<tr>
								<th>#</th><th>Категория</th><th>Провайдер</th><th>Тип IP</th><th>Протоколы</th><th>Цена</th><th>Pay-as-you-go</th><th>Заметка</th>
							</tr>
						</thead>
						<tbody>
							{proxyUS.map((x) => (
								<tr>
									<td class="cell-muted">{x.id}</td>
									<td><span class="badge">{x.category}</span></td>
									<td><a href={x.url} target="_blank" rel="noreferrer">{x.provider}</a></td>
									<td>{x.ipType}</td><td>{x.protocols}</td><td class="nowrap">{x.pricing}</td><td>{x.payg}</td><td class="cell-note">{x.notes}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="mini" style="margin:12px 0 0;">Оригинальный документ: <a href={`${baseUrl}proxy-us/`}>Proxy (US)</a></p>
			</div>
		</div>
	</section>

	<script is:inline>
		const $ = (sel) => document.querySelector(sel);
		const rows = Array.from(document.querySelectorAll("#rows tr"));
		const q = $("#q");
		const country = $("#country");
		const tier = $("#tier");
		const avail = $("#avail");
		const count = $("#count");
		const tabVps = $("#tab-vps");
		const tabProxy = $("#tab-proxy");
		const panelVps = $("#panel-vps");
		const panelProxy = $("#panel-proxy");

		function availabilityMatches(mode, value) {
			if (mode === "ALL") return true;
			if (mode === "bad") return value === "sold_out" || value === "unavailable";
			return value === mode;
		}

		function applyFilters() {
			const query = (q.value || "").trim().toLowerCase();
			let visible = 0;
			for (const r of rows) {
				const ok = (!query || (r.dataset.text || "").includes(query))
					&& (country.value === "ALL" || r.dataset.country === country.value)
					&& (tier.value === "ALL" || r.dataset.tier === tier.value)
					&& availabilityMatches(avail.value, r.dataset.availability);
				r.style.display = ok ? "" : "none";
				if (ok) visible++;
			}
			count.textContent = String(visible);
		}

		[q, country, tier, avail].forEach((el) => el.addEventListener("input", applyFilters));
		applyFilters();

		function setTab(name) {
			const isVps = name === "vps";
			panelVps.style.display = isVps ? "" : "none";
			panelProxy.style.display = isVps ? "none" : "";
			tabVps.classList.toggle("is-active", isVps);
			tabProxy.classList.toggle("is-active", !isVps);
		}
		tabVps.addEventListener("click", () => setTab("vps"));
		tabProxy.addEventListener("click", () => setTab("proxy"));
	</script>
</BaseLayout>
