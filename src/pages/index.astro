---
import BaseLayout from '../layouts/BaseLayout.astro';
import SingleServerCatalog from '../components/SingleServerCatalog.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="VPS в Европе с оплатой из России — VPS Research"
  description="Выбор одного недорогого европейского VPS: цена, российские способы оплаты, IPv4, ограничения и источники с датой проверки."
>
  <SingleServerCatalog />
  <p class="previous-research">
    Предыдущие исследования: <a href={`${base}pairs/`}>пары VPS</a>,
    <a href={`${base}tables/#archive`}>архив сравнения 28 предложений</a>
    и <a href={`${base}vps-eu/`}>аудит рынка от 3 сентября 2026</a>.
  </p>
</BaseLayout>
<style>
  .previous-research { margin-top: 1.75rem; padding-top: 1rem; border-top: 1px solid var(--stroke); color: var(--muted); font-size: .95rem; }
  .previous-research a { color: var(--accent2); text-underline-offset: .2em; }
</style>
