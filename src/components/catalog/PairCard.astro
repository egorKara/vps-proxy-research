---
import { pairNodes, pairTitle, decisionText, displayValue, formatDate } from '../../lib/catalog.js';
const { pair } = Astro.props;
const [entry, foreign] = pairNodes(pair);
const base = import.meta.env.BASE_URL;
const unknownCount = pair.criteria.filter((c) => c.status === 'UNKNOWN').length;
const riskyCount = pair.criteria.filter((c) => c.status === 'RISK').length;
---
<article class="pair-card">
  <div class="pair-card-top">
    <div><p class="eyebrow">Два VPS · один профиль</p><h3><a href={`${base}pairs/${pair.id}/`}>{pairTitle(pair)}</a></h3></div>
    <span class="decision" data-decision={pair.decision}>{decisionText(pair.decision)}</span>
  </div>
  <div class="route-line" aria-label="Маршрут пары">
    <div><span class="route-node">01 · Первый VPS</span><strong>{displayValue(entry?.properties.city?.value)}</strong><small>{displayValue(entry?.properties.plan?.value)}</small></div>
    <span class="route-arrow" aria-hidden="true">→</span>
    <div><span class="route-node">02 · Выход</span><strong>{displayValue(foreign?.properties.city?.value)}</strong><small>{displayValue(foreign?.properties.plan?.value)}</small></div>
  </div>
  <div class="pair-summary">
    <div><span>Условия</span><strong>{unknownCount} не установлено{riskyCount ? ` · ${riskyCount} риск` : ''}</strong></div>
    <div><span>Ориентиры тарифов</span><strong>{pair.price.components.map((c) => `${c.amount ?? '?'} ${c.currency ?? '?'}`).join(' · ') || 'Не установлены'}</strong></div>
  </div>
  <p class="pair-reason">{pair.reason}</p><p class="price-warning">Окончательный счёт и наличие при заказе не подтверждены.</p>
  <div class="pair-card-bottom"><span>Оценка: {formatDate(pair.decisionAt || pair.criteria[0]?.evaluatedAt)} · <span data-freshness={pair.decisionAt || pair.criteria[0]?.evaluatedAt || ''} data-frequency="weekly">Проверка свежести…</span></span><a class="text-link" href={`${base}pairs/${pair.id}/`}>Основания и источники <span aria-hidden="true">↗</span></a></div>
</article>
