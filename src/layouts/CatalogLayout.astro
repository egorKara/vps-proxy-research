---
import '../styles/catalog.css';
const { title, description = 'Сравнение независимых VPS-пар с источниками, неизвестными и датами проверки.', current = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [ ['Пары', base, 'pairs'], ['Изменения', `${base}changes/`, 'changes'], ['Методика', `${base}method/`, 'method'], ['Архив', `${base}archive/`, 'archive'] ];
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · VPS-пары</title>
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержимому</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="site-brand" href={base}>VPS<span class="brand-separator">/</span>пары <small>проверяемое сравнение</small></a>
      <nav aria-label="Основная навигация" class="site-nav">
        {links.map(([label, href, key]) => <a href={href} aria-current={current === key ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main" class="wrap"><slot /></main>
  <footer class="site-footer wrap">
    <span>Сведения о провайдерах и маршрутах требуют проверки перед покупкой.</span>
    <a href={`${base}method/#terms`}>Сокращения и классы</a>
  </footer>
  <script is:inline>
    function updateFreshness() {
      document.querySelectorAll('[data-freshness]').forEach((el) => {
        const value = el.getAttribute('data-freshness');
        const frequency = el.getAttribute('data-frequency');
        const age = Date.now() - Date.parse(value || '');
        const limit = frequency === 'weekly' ? 14 * 86400000 : 48 * 3600000;
        const unknown = !Number.isFinite(age);
        el.textContent = unknown ? 'Нет успешной проверки' : age > limit ? 'Данные устарели' : 'В пределах порога свежести';
        el.dataset.state = unknown ? 'unknown' : age > limit ? 'stale' : 'fresh';
        const criterion = el.closest('.criterion');
        const badge = criterion?.querySelector('.criterion-status[data-status="PASS"], .criterion-status[data-status="STALE"]');
        if (badge) {
          badge.textContent = unknown || age > limit ? 'Требует перепроверки' : 'Условие подтверждено';
          badge.dataset.status = unknown || age > limit ? 'STALE' : 'PASS';
        }
      });
    }
    updateFreshness();
    document.addEventListener('visibilitychange', () => { if (!document.hidden) updateFreshness(); });
  </script>
</body>
</html>
